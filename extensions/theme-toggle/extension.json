{
  "id": "theme-toggle",
  "name": "Theme Toggle",
  "description": "Adds a sun/moon theme toggle button under the Settings cog in the icon rail (desktop) and sidebar nav (mobile). Uses the built-in _pickTheme() function so the choice persists and syncs with Settings \u2192 Appearance.",
  "version": "2.1.0",
  "author": "daverave999",
  "assets": {
    "scripts": [
      "assets/theme-toggle.js"
    ],
    "stylesheets": [
      "assets/theme-toggle.css"
    ]
  },
  "capabilities": [
    "manifest-bundle"
  ],
  "lifecycle": {
    "webui_restart_required": false,
    "sidecar_start_required": false,
    "native_host_start_required": false,
    "native_host_autostart": "none"
  },
  "screenshots": [
    "screenshots/rail-toggle.png"
  ],
  "permissions": {
    "webui_api": {
      "read": [],
      "write": []
    },
    "webui_navigation": false,
    "dom": {
      "owned": true,
      "mutates_core_views": true
    },
    "storage": {
      "owned": [],
      "shared_webui_keys": []
    },
    "loopback_sidecar": false,
    "native_host": false,
    "filesystem": {
      "arbitrary": false,
      "serves_bundled_assets": true
    },
    "network_external": false,
    "registers_skin": false
  }
}
